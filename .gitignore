# Environment & secrets
# (.env.example 은 의도적으로 추적한다 — 아래 패턴 어디에도 걸리지 않음)
.env
*.env
.env.bak.*
google_sa.json
instagram_session.json

# 서비스 계정 / 자격증명 파일
credentials.json
credentials-*.json
client_secret*.json
service_account*.json
service-account*.json
*-service-account.json
gcp-*.json
firebase-adminsdk*.json
aws_credentials
.aws/credentials

# 키 / 인증서 (개인키류)
*.pem
# 예외: AWS RDS 공개 CA 번들 (개인키 아님 — DB MCP 가 RDS 인증서 검증에 사용)
!.claude/mcp/rds-global-bundle.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.asc
*.gpg

# DB 비밀번호 / API Key / Token 을 담는 파일
.pgpass
.netrc
secrets.json
secrets.yml
secrets.yaml
*.secret
*_secret.json
*.token
*_token.json
instagram_session*.json

# Claude Code 개인(로컬) 설정 — 프로젝트 공용 설정만 커밋한다
# (.claude/settings.json, hooks/, skills/, agents/, mcp/, lib/, memory/ 는 커밋 대상)
.claude/settings.local.json
.claude/worktrees/

# 머신 로컬 작업 상태 — 세션 스크래치·기계 저널·체크포인트 (공유 대상 아님)
# 영구 지식은 .claude/memory/ 에 두고 커밋한다
.claude/state/

# Node
node_modules/

# Database
*.db
*.sqlite
*.sqlite3

# Backups
backups/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.uv/
dist/
*.egg-info/

# Uploads (user content, not source)
static/uploads/

